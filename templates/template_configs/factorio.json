{
    "template_name": "factorio",
    "elements": [
        {
            "type": "separator",
            "label": "Layout"
        },
        {
            "type": "select",
            "id": "LayoutMode",
            "label": "Layout mode",
            "value": "grid",
            "description": "grid uses the row/column/span values below; row places visible segments left-to-right; column stacks them.",
            "options": [
                "grid",
                "row",
                "column"
            ]
        },
        {
            "type": "number",
            "id": "GridColumns",
            "label": "Grid columns",
            "value": 2,
            "min": 1,
            "max": 6,
            "description": "Number of CSS grid columns"
        },
        {
            "type": "number",
            "id": "GridRows",
            "label": "Grid rows",
            "value": 4,
            "min": 1,
            "max": 8,
            "description": "Number of CSS grid rows"
        },
        {
            "type": "number",
            "id": "GridGap",
            "label": "Grid gap (px)",
            "value": 6,
            "min": 0,
            "max": 48,
            "description": "Gap between grid cells"
        },
        {
            "type": "number",
            "id": "Scale",
            "label": "Scale",
            "value": 1.0,
            "min": 0.5,
            "max": 2.0,
            "description": "Overall overlay scale"
        },
        {
            "type": "number",
            "id": "PanelOpacity",
            "label": "Panel opacity",
            "value": 0.96,
            "min": 0.2,
            "max": 1.0,
            "description": "Background opacity of each panel"
        },
        {
            "type": "checkbox",
            "id": "ShowTitleBars",
            "label": "Show title bars",
            "value": true,
            "description": "Show the Factorio-style title strip on each panel"
        },
        {
            "type": "number",
            "id": "PlanetCycleSeconds",
            "label": "Planet cycle time (sec)",
            "value": 8,
            "min": 2,
            "max": 120,
            "description": "How long each visited planet stays on screen when a panel is in cycle mode. Power, Production, Consumption, and Fluids stay in sync."
        },
        {
            "type": "select",
            "id": "FontFile",
            "label": "Font file",
            "value": "TitilliumWeb-Regular.ttf",
            "options_from": "fonts",
            "options": [],
            "description": "Font in assets/default_assets/fonts/"
        },
        {
            "type": "separator",
            "label": "Production & consumption"
        },
        {
            "type": "textarea",
            "id": "ProductionItems",
            "label": "Tracked items",
            "value": "",
            "description": "One prototype name per line (iron-plate, electronic-circuit, \u2026). Leave blank to show the top items automatically."
        },
        {
            "type": "number",
            "id": "ProductionTopN",
            "label": "Auto top N",
            "value": 12,
            "min": 1,
            "max": 40,
            "description": "When the tracked-item list is blank, show this many items by rate"
        },
        {
            "type": "select",
            "id": "ProductionPrecision",
            "label": "Time window",
            "value": "one_minute",
            "description": "Averaging window matching Factorio's production GUI",
            "options": [
                "five_seconds",
                "one_minute",
                "ten_minutes",
                "one_hour",
                "ten_hours",
                "fifty_hours",
                "two_hundred_fifty_hours",
                "one_thousand_hours"
            ]
        },
        {
            "type": "checkbox",
            "id": "ProductionShowIcons",
            "label": "Show item icons",
            "value": true,
            "description": "Load icons from the local Factorio install"
        },
        {
            "type": "checkbox",
            "id": "ProductionShowTotals",
            "label": "Show lifetime totals",
            "value": false,
            "description": "Show lifetime produced/consumed next to the rate"
        },
        {
            "type": "textarea",
            "id": "FluidItems",
            "label": "Tracked fluids",
            "value": "",
            "description": "One fluid prototype per line. Blank = auto top N."
        },
        {
            "type": "separator",
            "label": "Power"
        },
        {
            "type": "select",
            "id": "PowerNetworkMode",
            "label": "Power network",
            "value": "auto_largest",
            "description": "Which electric network the companion mod reports (largest on the current surface by default)",
            "options": [
                "auto_largest",
                "player_surface",
                "pinned"
            ]
        },
        {
            "type": "text",
            "id": "PowerSurface",
            "label": "Pinned surface",
            "value": "",
            "description": "Used when Power network is pinned (nauvis, vulcanus, \u2026)"
        },
        {
            "type": "checkbox",
            "id": "PowerShowProducers",
            "label": "Show producers",
            "value": true,
            "description": "List generator types under the power bars"
        },
        {
            "type": "checkbox",
            "id": "PowerShowConsumers",
            "label": "Show consumers",
            "value": true,
            "description": "List consumer types under the power bars"
        },
        {
            "type": "select",
            "id": "PowerBarStyle",
            "label": "Bar style",
            "value": "green",
            "description": "Fill color for the satisfaction / production / charge bars",
            "options": [
                "green",
                "orange"
            ]
        },
        {
            "type": "separator",
            "label": "Hook"
        },
        {
            "type": "text",
            "id": "FactorioDataDir",
            "label": "Factorio data folder",
            "value": "",
            "description": "Override if auto-detect fails. Example: ~/Library/Application Support/factorio"
        },
        {
            "type": "number",
            "id": "StalenessSeconds",
            "label": "Stale after (sec)",
            "value": 5,
            "min": 1,
            "max": 60,
            "description": "Treat the export as paused when the JSON file is older than this (single-player pause)"
        },
        {
            "type": "separator",
            "label": "Power"
        },
        {
            "type": "checkbox",
            "id": "ShowPower",
            "label": "Show power panel",
            "value": true,
            "description": "Toggle the Power segment"
