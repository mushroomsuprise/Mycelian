{
    "template_name": "ff7",
    "elements": [
        {
            "type": "separator",
            "label": "Grid Layout"
        },
        {
            "type": "number",
            "id": "GridColumns",
            "label": "Grid columns",
            "value": 1.0,
            "min": 1,
            "max": 6,
            "description": "Number of CSS grid columns"
        },
        {
            "type": "number",
            "id": "GridRows",
            "label": "Grid rows",
            "value": 3.0,
            "min": 1,
            "max": 6,
            "description": "Number of CSS grid rows"
        },
        {
