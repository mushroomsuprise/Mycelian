            "id": "LineHeight",
            "label": "Line Height",
            "value": 1.2,
            "min": 0.8,
            "max": 2.0,
            "step": 0.1,
            "description": "Line height multiplier for text"
        },
        {
            "type": "separator",
            "label": "Container Settings"
