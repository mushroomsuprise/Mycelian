        {
            "type": "number",
            "id": "TitleTop",
            "label": "Container Top Position",
            "value": 50,
            "min": 0,
            "max": 2000,
            "description": "Top position of the title container in pixels"
        },
        {
            "type": "number",
            "id": "TitleLeft",
            "label": "Container Left Position",
            "value": 50,
            "min": 0,
            "max": 2000,
            "description": "Left position of the title container in pixels"
