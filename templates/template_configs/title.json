        {
            "type": "number",
            "id": "ContainerPadding",
            "label": "Container Padding",
            "value": 10,
            "min": 0,
            "max": 50,
            "description": "Internal padding of the container in pixels"
        },
        {
            "type": "separator",
            "label": "Display Settings"
        },
        {
            "type": "text",
            "id": "CategoryPrefix",
            "label": "Category Prefix",
            "value": "",
            "description": "Text placed before the category name when Show Category is on"
        },
        {
            "type": "text",
            "id": "CategorySuffix",
            "label": "Category Suffix",
            "value": "",
            "description": "Text placed after the category name when Show Category is on"
        },
        {
            "type": "separator",
            "label": "Behavior Settings"
        },
        {
            "type": "separator",
            "label": "Animation Settings"
        },
        {
            "type": "checkbox",
            "id": "EnableAnimations",
            "label": "Enable Animations",
            "value": true,
            "description": "Enable smooth transitions when text changes"
        },
        {
            "type": "number",
            "id": "TransitionDuration",
            "label": "Transition Duration",
            "value": 0.3,
            "min": 0.1,
            "max": 2.0,
            "step": 0.1,
            "description": "Duration of text change animations in seconds"
        },
        {
            "type": "checkbox",
            "id": "EnablePulse",
            "label": "Enable Pulse Effect",
            "value": false,
            "description": "Enable pulsing animation for the title"
        },
        {
            "type": "number",
            "id": "PulseSpeed",
            "label": "Pulse Speed",
            "value": 2.0,
            "min": 0.5,
            "max": 5.0,
            "step": 0.1,
            "description": "Speed of pulse animation in seconds"
        },
        {
            "type": "number",
            "id": "PulseOpacity",
            "label": "Pulse Opacity",
            "value": 0.7,
            "min": 0.1,
            "max": 0.9,
            "step": 0.1,
            "description": "Minimum opacity during pulse animation"
        },
        {
            "type": "checkbox",
            "id": "EnableGlow",
            "label": "Enable Glow Effect",
            "value": false,
            "description": "Enable glow effect around the title text"
        },
