        {
            "type": "separator",
            "label": "Wipe Animation Settings"
        },
        {
            "type": "checkbox",
            "id": "EnableWipe",
            "label": "Enable Wipe Animation",
            "value": true,
            "description": "Enable wipe transition when title changes"
        },
        {
            "type": "select",
            "id": "WipeDirection",
            "label": "Wipe Direction",
            "value": "left-to-right",
            "options": [
                "left-to-right",
                "right-to-left",
                "top-to-bottom",
                "bottom-to-top"
            ],
            "description": "Direction of the wipe animation"
        },
        {
            "type": "number",
            "id": "WipeEasing",
            "label": "Wipe Easing Strength",
            "value": 0.25,
            "min": 0.1,
            "max": 1.0,
            "step": 0.05,
            "description": "Easing curve strength for wipe animation (0.1=linear, 1.0=dramatic)"
        }
    ],
    "dynamic_controls": {
        "elements": [
            {
                "type": "toggle",
                "id": "show_category_toggle",
                "label": "Show Category",
                "description": "Display your live Twitch category on stream. Turn off to show a custom title instead.",
                "action": "toggle_show_category",
                "value": true
            },
            {
                "type": "text_input",
                "id": "manual_title_input",
                "label": "Custom Title",
                "description": "Text shown while Show Category is off. Leave empty for a blank overlay.",
                "placeholder": "Enter custom title...",
                "action": "set_manual_title",
                "max_length": 100
            },
            {
                "type": "button",
                "id": "clear_manual_title",
                "label": "Clear Custom Title",
                "description": "Clear the custom title and turn Show Category back on.",
                "button_text": "Clear",
                "action": "clear_manual_title",
                "data": {}
            },
            {
                "type": "button",
                "id": "refresh_title",
                "label": "Refresh Category",
                "description": "Fetch the current category from Twitch now (only when Show Category is on).",
                "button_text": "Refresh",
                "action": "refresh_title",
                "data": {}
            }
        ]
    },
    "connector_actions": {
        "change_title": {
            "action_name": "Change title",
            "trigger": "change_title",
            "elements": [
                {
                    "type": "text",
                    "id": "title_text",
                    "label": "Title Text",
                    "value": "{{username}} just followed!",
                    "description": "The title text to display. Use {{placeholder}} for dynamic content."
                },
                {
                    "type": "switch",
                    "id": "set_custom",
                    "label": "Set as Custom Title",
                    "value": false,
                    "description": "If enabled, this will override automatic title updates"
                },
                {
                    "type": "number",
                    "id": "display_duration",
                    "label": "Display Duration (seconds)",
                    "value": 10,
                    "min": 1,
                    "max": 120,
                    "description": "How long to display this title before reverting (0 = permanent)"
                }
            ]
        }
    }
}
