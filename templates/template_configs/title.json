        {
            "type": "number",
            "id": "TitleHeight",
            "label": "Container Height",
            "value": 100,
            "min": 50,
            "max": 500,
            "description": "Height of the title container in pixels"
        },
        {
            "type": "select",
            "id": "TitleAlign",
            "label": "Text Alignment",
            "value": "flex-start",
            "options": [
                "flex-start",
                "center",
                "flex-end"
            ],
            "description": "Horizontal alignment of title text (flex-start=left, center=center, flex-end=right)"
