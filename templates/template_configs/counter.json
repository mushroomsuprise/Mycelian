{
    "template_name": "counter",
    "elements": [
        {
            "type": "separator",
            "label": "Font Settings"
        },
        {
            "type": "text",
            "id": "FontName",
            "label": "Font File",
            "value": "Renogare.ttf",
            "description": "Font file name (must be in /assets/default_assets/fonts/ directory)"
        },
        {
            "type": "separator",
            "label": "Content Settings"
        },
        {
            "type": "text",
            "id": "Message",
            "label": "Counter Message",
            "value": "Counter: 0",
            "description": "The message to display in the counter"
        },
        {
            "type": "separator",
            "label": "Container Settings"
        },
        {
            "type": "number",
            "id": "ContainerTop",
            "label": "Container Top Position",
            "value": 920,
            "min": 0,
            "max": 2000,
            "description": "Top position of the counter container in pixels"
        },
        {
            "type": "number",
            "id": "ContainerLeft",
            "label": "Container Left Position",
            "value": 500,
            "min": 0,
            "max": 2000,
            "description": "Left position of the counter container in pixels"
        },
        {
            "type": "number",
            "id": "ContainerWidth",
            "label": "Container Width",
            "value": 1000,
            "min": 200,
            "max": 2000,
            "description": "Width of the counter container in pixels"
        },
        {
            "type": "number",
            "id": "ContainerHeight",
            "label": "Container Height",
            "value": 45,
            "min": 20,
            "max": 200,
            "description": "Height of the counter container in pixels"
        },
        {
            "type": "separator",
            "label": "Text Settings"
        },
        {
            "type": "select",
            "id": "TextAlign",
            "label": "Text Alignment",
            "value": "right",
            "options": [
                "left",
                "center",
                "right",
                "justify"
            ],
            "description": "Horizontal text alignment"
        },
        {
            "type": "select",
            "id": "JustifyContent",
            "label": "Content Justification",
            "value": "flex-end",
            "options": [
                "flex-start",
                "center",
                "flex-end",
                "space-between",
                "space-around",
                "space-evenly"
            ],
            "description": "Flex container content justification"
        },
