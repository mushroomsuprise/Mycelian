            "type": "number",
            "id": "FontSize",
            "label": "Font Size",
            "value": 29,
            "min": 12,
            "max": 100,
            "description": "Font size for the counter text in pixels"
        },
        {
            "type": "select",
            "id": "FontWeight",
            "label": "Font Weight",
            "value": "normal",
            "options": [
                "normal",
                "bold",
                "bolder",
                "lighter",
                "100",
                "200",
                "300",
                "400",
                "500",
                "600",
                "700",
                "800",
                "900"
            ],
            "description": "Font weight for counter text"
        },
        {
            "type": "text",
            "id": "TextShadow",
            "label": "Text Shadow",
            "value": "2px 2px 4px rgba(0,0,0,0.8)",
            "description": "CSS text shadow for counter text"
        },
        {
            "type": "select",
            "id": "WhiteSpace",
            "label": "White Space Handling",
            "value": "nowrap",
            "options": [
                "normal",
                "nowrap",
                "pre",
                "pre-wrap",
                "pre-line"
            ],
            "description": "How white space is handled in the text"
        },
        {
            "type": "select",
            "id": "WordWrap",
            "label": "Word Wrap",
            "value": "normal",
            "options": [
                "normal",
                "break-word",
                "anywhere"
            ],
            "description": "How long words are wrapped"
        },
        {
            "type": "separator",
            "label": "Background Settings"
