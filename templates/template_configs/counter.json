            "id": "BackgroundShadow",
            "label": "Background Shadow",
            "value": "0 2px 10px rgba(0,0,0,0.3)",
            "description": "CSS box shadow for background"
        },
        {
            "type": "number",
            "id": "BackgroundOpacity",
            "label": "Background Opacity",
            "value": 0.8,
            "min": 0,
            "max": 1,
            "step": 0.1,
            "description": "Opacity of the background (0 = transparent, 1 = opaque)"
        },
        {
            "type": "checkbox",
            "id": "EnableAnimations",
            "label": "Enable Animations",
            "value": true,
            "description": "Whether to enable animations for counter updates"
        },
        {
            "type": "select",
            "id": "AnimationType",
            "label": "Animation Type",
            "value": "fade-in",
            "options": [
                "fade-in",
                "slide-in",
                "bounce"
            ],
            "description": "Type of animation for counter updates"
        },
        {
            "type": "number",
            "id": "AnimationDuration",
            "label": "Animation Duration",
            "value": 0.5,
            "min": 0.1,
            "max": 3,
            "step": 0.1,
            "description": "Duration of animations in seconds"
        },
        {
            "type": "select",
            "id": "AnimationEasing",
            "label": "Animation Easing",
            "value": "ease-out",
            "options": [
                "linear",
                "ease",
                "ease-in",
                "ease-out",
                "ease-in-out"
            ],
            "description": "Easing function for animations"
        },
        {
            "type": "checkbox",
            "id": "EnablePulse",
            "label": "Enable Pulse Animation",
            "value": false,
            "description": "Whether to enable continuous pulse animation"
        },
        {
            "type": "number",
            "id": "PulseScale",
            "label": "Pulse Scale Factor",
            "value": 1.1,
            "min": 1,
            "max": 2,
            "step": 0.1,
            "description": "Scale factor for pulse animation (1 = no scaling)"
        },
        {
            "type": "checkbox",
            "id": "AutoRefresh",
            "label": "Auto Refresh",
            "value": false,
            "description": "Whether to automatically refresh the counter periodically"
        },
        {
            "type": "number",
            "id": "RefreshInterval",
            "label": "Refresh Interval",
            "value": 30,
            "min": 5,
            "max": 300,
            "description": "Auto refresh interval in seconds (only if auto refresh is enabled)"
        }
    ],
    "dynamic_controls": {
        "elements": [
            {
                "type": "counter_control",
                "id": "counter_controls",
                "label": "Counter Controls",
                "description": "Increment, decrement, or reset the counter",
                "action_increment": "increment",
                "action_decrement": "decrement",
                "action_reset": "reset"
            },
            {
                "type": "number_input",
                "id": "value",
                "label": "Set Counter Value",
                "description": "Set the counter to a specific value",
                "min": 0,
                "max": 999999,
                "value": 0,
                "action": "update"
            }
        ]
    },
    "streamdeck_options": {
        "description": "Counter template for Stream Deck integration",
        "actions": {
            "increment": {
                "name": "Increment Counter",
                "description": "Increase the counter by 1",
                "event": "counter_update",
                "default_data": {
                    "action": "increment"
                }
            },
            "decrement": {
                "name": "Decrement Counter",
                "description": "Decrease the counter by 1",
                "event": "counter_update",
                "default_data": {
                    "action": "decrement"
                }
            },
            "reset": {
                "name": "Reset Counter",
                "description": "Reset the counter to 0",
                "event": "counter_update",
                "default_data": {
                    "action": "reset"
                }
            },
            "set_value": {
                "name": "Set Counter Value",
                "description": "Set the counter to a specific value",
                "event": "counter_update",
                "default_data": {
                    "action": "set",
                    "value": 0
                }
            }
        }
    },
    "connector_actions": {
        "increase_counter": {
            "action_name": "Increase the counter",
            "trigger": "increase_counter",
            "elements": [
                {
                    "type": "number",
                    "id": "increment_value",
                    "label": "Increment Value",
                    "value": 1,
                    "min": 1,
                    "max": 1000,
                    "description": "Amount to increase the counter by"
                }
            ]
        },
        "decrease_counter": {
            "action_name": "Decrease the counter",
            "trigger": "decrease_counter",
            "elements": [
                {
                    "type": "number",
                    "id": "decrement_value",
                    "label": "Decrement Value",
                    "value": 1,
                    "min": 1,
                    "max": 1000,
                    "description": "Amount to decrease the counter by"
                }
            ]
        },
        "reset_counter": {
            "action_name": "Reset the counter",
            "trigger": "reset_counter",
            "elements": [
                {
                    "type": "number",
                    "id": "reset_value",
                    "label": "Reset Value",
                    "value": 0,
                    "min": -1000,
                    "max": 1000,
                    "description": "Value to reset the counter to"
                }
            ]
        }
    }
}
