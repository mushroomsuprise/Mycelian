{
    "template_name": "alerts",
    "elements": [
        {
            "type": "text",
            "id": "Font",
            "label": "Font File",
            "value": "Renogare.ttf",
            "description": "Font file name (must be in /assets/default_assets/fonts/ directory)"
        },
        {
            "type": "number",
            "id": "AlertWidth",
            "label": "Alert Width",
            "value": 700,
            "min": 100,
            "max": 2000,
            "description": "Width of the alert container in pixels"
        },
        {
            "type": "number",
            "id": "AlertHeight",
            "label": "Alert Height",
            "value": 200,
            "min": 50,
            "max": 1000,
            "description": "Height of the alert container in pixels"
        },
        {
            "type": "separator",
            "label": "Alert Type Toggles"
        },
        {
            "type": "checkbox",
            "id": "EnableFollowAlerts",
            "label": "Enable Follow Alerts",
            "value": true,
            "description": "Show alerts for new followers"
        },
        {
            "type": "checkbox",
            "id": "EnableSubAlerts",
            "label": "Enable Subscription Alerts",
            "value": true,
            "description": "Show alerts for new subscriptions"
        },
        {
            "type": "checkbox",
            "id": "EnableResubAlerts",
            "label": "Enable Resubscription Alerts",
            "value": true,
            "description": "Show alerts for resubscriptions"
        },
        {
            "type": "checkbox",
            "id": "EnableGiftsubAlerts",
            "label": "Enable Gift Sub Alerts",
            "value": true,
            "description": "Show alerts for gift subscriptions"
        },
        {
            "type": "checkbox",
            "id": "EnableBitAlerts",
            "label": "Enable Bit Alerts",
            "value": true,
            "description": "Show alerts for bit donations"
        },
        {
            "type": "checkbox",
            "id": "EnableRaidAlerts",
            "label": "Enable Raid Alerts",
            "value": true,
            "description": "Show alerts for raids"
        },
        {
            "type": "checkbox",
            "id": "EnablePointAlerts",
            "label": "Enable Channel Point Alerts",
            "value": true,
            "description": "Show alerts for channel point redemptions"
        },
        {
            "type": "checkbox",
            "id": "EnableDonationAlerts",
            "label": "Enable Donation Alerts",
            "value": true,
            "description": "Show alerts for donations"
        },
        {
            "type": "checkbox",
            "id": "EnableHypeTrainAlerts",
            "label": "Enable Hype Train Alerts",
            "value": true,
            "description": "Show alerts for hype train events"
        },
        {
            "type": "separator",
            "label": "Alert Timing Settings"
        },
        {
            "type": "number",
            "id": "DelayBetweenAlerts",
            "label": "Delay Between Alerts",
            "value": 0.5,
            "min": 0,
            "max": 10,
            "step": 0.1,
            "description": "Delay in seconds between consecutive alerts"
        },
        {
            "type": "separator",
            "label": "Text To Speech Settings"
        },
        {
            "type": "number",
            "id": "TtsRate",
            "label": "TTS Speech Rate",
            "value": 1.0,
            "min": 0.1,
            "max": 2.0,
            "step": 0.1,
            "description": "Speech rate for browser text-to-speech playback"
        },
        {
            "type": "number",
