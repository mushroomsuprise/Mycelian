        {
            "type": "select",
            "id": "BackgroundVideoFit",
            "label": "Background Video Fit",
            "value": "cover",
            "options": [
                "cover",
                "contain",
                "fill",
                "scale-down",
                "none"
            ],
            "description": "How the background video should fit within its container"
        },
        {
            "type": "checkbox",
            "id": "BackgroundVideoLoop",
            "label": "Loop Background Video",
            "value": false,
            "description": "When off, the video plays once and stays on the last frame for the remainder of the alert (matches long on-screen time to per-alert duration)."
        },
        {
            "type": "number",
            "id": "BackgroundVideoFreezeAfterSeconds",
            "label": "Freeze Video After (seconds)",
            "value": 2.0,
            "min": 0,
            "max": 600,
            "step": 0.1,
            "description": "0 = freeze only when the clip ends (with looping off) or when the clip naturally ends. Greater than 0 = pause on the current frame after this many seconds; hold stays until the alert ends, so hold length follows each alert's duration."
        },
