            "type": "number",
            "id": "BounceAnimationDuration",
            "label": "Bounce Animation Duration",
            "value": 2,
            "min": 0.5,
            "max": 5,
            "step": 0.1,
            "description": "Duration of one bounce cycle in seconds"
        },
        {
            "type": "select",
            "id": "BounceAnimationEasing",
            "label": "Bounce Animation Easing",
            "value": "ease-out",
            "options": [
                "linear",
                "ease",
                "ease-in",
                "ease-out",
                "ease-in-out"
            ],
            "description": "Easing function for bounce animation"
