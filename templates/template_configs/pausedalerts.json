            "type": "checkbox",
            "id": "EnablePulse",
            "label": "Enable Pulse Animation",
            "value": true,
            "description": "Whether to enable pulse animation when paused"
        },
        {
            "type": "number",
            "id": "PulseAnimationDuration",
            "label": "Pulse Animation Duration",
            "value": 2,
            "min": 0.5,
            "max": 5,
            "step": 0.1,
            "description": "Duration of one pulse cycle in seconds"
        },
        {
            "type": "select",
            "id": "PulseAnimationEasing",
            "label": "Pulse Animation Easing",
            "value": "ease-in-out",
            "options": [
                "linear",
                "ease",
                "ease-in",
                "ease-out",
                "ease-in-out"
            ],
            "description": "Easing function for pulse animation"
        },
        {
            "type": "number",
            "id": "PulseScale",
            "label": "Pulse Scale Factor",
            "value": 1.2,
            "min": 1,
            "max": 2,
            "step": 0.1,
            "description": "Scale factor for pulse animation (1 = no scaling)"
        },
        {
            "type": "number",
            "id": "PulseOpacity",
            "label": "Pulse Opacity",
            "value": 0.7,
            "min": 0,
            "max": 1,
            "step": 0.1,
            "description": "Opacity at the peak of pulse animation"
        },
        {
            "type": "checkbox",
            "id": "EnableBounce",
            "label": "Enable Bounce Animation",
            "value": false,
            "description": "Whether to enable bounce animation when paused"
        },
