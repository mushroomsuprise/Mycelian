        },
        {
            "type": "select",
            "id": "AnimationEasing",
            "label": "Animation Easing",
            "value": "ease-out",
            "options": [
                "linear",
                "ease",
                "ease-in",
                "ease-out",
                "ease-in-out"
            ],
            "description": "Easing function for general animations"
        },
        {
            "type": "number",
            "id": "FadeAnimationDuration",
            "label": "Fade Animation Duration",
            "value": 0.5,
            "min": 0.1,
            "max": 3,
            "step": 0.1,
            "description": "Duration of fade in/out animations in seconds"
        },
        {
            "type": "select",
            "id": "FadeAnimationEasing",
            "label": "Fade Animation Easing",
            "value": "ease-out",
            "options": [
                "linear",
                "ease",
                "ease-in",
                "ease-out",
                "ease-in-out"
            ],
            "description": "Easing function for fade animations"
        },
