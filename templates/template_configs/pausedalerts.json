            "type": "number",
            "id": "BounceHeight",
            "label": "Bounce Height",
            "value": 20,
            "min": 5,
            "max": 100,
            "description": "Height of the bounce animation in pixels"
        },
        {
            "type": "checkbox",
            "id": "AutoHide",
            "label": "Auto Hide",
            "value": false,
            "description": "Whether to automatically hide the icon after a delay"
        },
